# =========================================================
# ~/.config/zsh/local.zsh - Host-Specific & Private Overrides
# Copy this file to ~/.config/zsh/local.zsh to customize your
# environment without committing secrets or changes to Git.
# =========================================================

# --- Multimedia & Third-Party API Keys ---
# Generate Giphy API Key at: https://developers.giphy.com/
# export GIPHY_API_KEY="your_giphy_api_key_here"

# Generate Klipy API Key at: https://klipy.co/
# export KLIPY_API_KEY="your_klipy_api_key_here"

# --- Machine-Specific PATH & Variables ---
# export LIBVIRT_DEFAULT_URI="qemu:///system"
# export QML2_IMPORT_PATH="$HOME/.local/lib/qt6/qml"
# export CAELESTIA_LIB_DIR="$HOME/.local/lib/caelestia"
# export ENDCORD_VOICE_OPUS_MODE="audio"

