# Runtime downloaded plugins (auto-cloned on first run)
.config/zsh/plugins/
plugins/

# Cache, compdump & temporary files
.config/zsh/.zcompdump*
.zcompdump*
.cache/
*.swp
*.tmp
*~

# History & state
.local/
history
*.log

# Local private overrides, secrets and current theme
.config/zsh/local.zsh
.config/zsh/secrets.zsh
.config/zsh/current_theme
local.zsh
secrets.zsh
*.local.zsh
.env*

